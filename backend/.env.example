# Server
PORT=5000
NODE_ENV=development

# Comma-separated origins. Use * only for local testing.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000

# AI Provider: openai | gemini | groq
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=750
