# Server
PORT=5000
NODE_ENV=development

# Comma-separated origins. Use * only for local testing.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000

# MySQL (MAMP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=dav_civil_services

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# AI Provider: openai | gemini | groq
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=750

# Razorpay TEST mode (no real money). Replace with Dashboard → Test Mode → API Keys.
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=
